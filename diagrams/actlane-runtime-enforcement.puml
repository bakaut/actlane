@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 16
skinparam ArrowColor #1B5EBE
skinparam RectangleBorderColor #1B5EBE
skinparam RectangleBackgroundColor #F8FBFF
skinparam NoteBackgroundColor #FFF8ED
skinparam NoteBorderColor #FF8A00

title Actlane Optional Runtime Enforcement

rectangle "Agent" as agent
rectangle "Existing MCP Gateway
Agent Runtime
or Local Wrapper" as gateway
rectangle "Actlane Policy Decision" as pdp
rectangle "Real Tools
GitHub / Sandbox / CI / Memory" as tools

agent --> gateway : tool-call
gateway --> pdp : check request
pdp --> gateway : allow / deny / mutate / approval
gateway --> tools : safe tool-call

note bottom of pdp
Generated from the same Capability
and ToolCallPolicy manifests.
end note
@enduml
