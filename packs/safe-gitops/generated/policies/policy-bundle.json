{
  "status": "phase-0-expected-output",
  "pack": "safe-gitops",
  "version": "0.1.0-rfc",
  "capabilities": ["create-safe-draft-pr", "run-project-tests"],
  "decisions": ["allow", "deny", "mutate", "requires-approval"],
  "rules": {
    "branchPrefix": "actlane/",
    "forceDraft": true,
    "maxFiles": 20,
    "maxDiffBytes": 120000,
    "forbiddenPaths": [".env", ".env.*", "**/*secret*", "**/*credential*", "**/*token*"]
  }
}
