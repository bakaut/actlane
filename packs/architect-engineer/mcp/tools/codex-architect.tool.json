{
  "name": "codex_architect_handoff",
  "description": "Run Codex as a single architect agent that prepares an engineer handoff without writing production code.",
  "inputSchema": {
    "type": "object",
    "required": ["role", "task", "repo"],
    "properties": {
      "role": { "type": "string", "const": "architect" },
      "task": { "type": "string" },
      "repo": { "type": "string" },
      "contextPrepareRef": { "type": "string", "default": "/context/prepare" },
      "constraints": { "type": "array", "items": { "type": "string" } },
      "confirmedArchitectureChange": { "type": "boolean", "default": false }
    }
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "facts": { "type": "array", "items": { "type": "string" } },
      "assumptions": { "type": "array", "items": { "type": "string" } },
      "decisions": { "type": "array", "items": { "type": "string" } },
      "risks": { "type": "array", "items": { "type": "string" } },
      "openQuestions": { "type": "array", "items": { "type": "string" } },
      "boundaries": { "type": "array", "items": { "type": "string" } },
      "contracts": { "type": "array", "items": { "type": "string" } },
      "flow": { "type": "string" },
      "engineerHandoff": { "type": "string" },
      "durableDecisionRefs": { "type": "array", "items": { "type": "string" } },
      "mcpSummaryRefs": { "type": "array", "items": { "type": "string" } }
    }
  }
}

