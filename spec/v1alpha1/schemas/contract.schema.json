{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/contract.schema.json",
  "title": "Actlane ResponsibilityContract",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "ResponsibilityContract" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "properties": {
        "sources": { "type": "object" },
        "precedence": { "type": "object" },
        "scopes": { "type": "array" },
        "risk": { "type": "object" },
        "checks": { "type": "object" },
        "permissions": { "type": "object" },
        "tools": { "type": "object" },
        "humanBoundary": { "type": "object" },
        "evidence": { "type": "object" },
        "agentBehavior": { "type": "object" },
        "handoffFormat": { "type": "object" },
        "audit": { "type": "object" }
      },
      "not": {
        "anyOf": [
          { "required": ["ci"] },
          { "required": ["acceptanceCriteria"] },
          { "required": ["adoption"] }
        ]
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
