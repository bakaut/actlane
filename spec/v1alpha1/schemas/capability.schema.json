{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/capability.schema.json",
  "title": "Actlane Capability",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "Capability" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "object",
          "properties": {
            "type": { "type": "string" },
            "whenToUse": {
              "type": "array",
              "items": { "type": "string" }
            },
            "whenNotToUse": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "interface": {
          "type": "object",
          "properties": {
            "input": { "type": "object" },
            "output": { "type": "object" }
          },
          "additionalProperties": false
        },
        "policyRef": { "$ref": "#/$defs/localRef" },
        "executionRef": { "$ref": "#/$defs/localRef" },
        "workflowHints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "purpose"],
            "properties": {
              "step": { "type": "string" },
              "purpose": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "projections": {
          "type": "object",
          "properties": {
            "mcp": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "toolName": { "type": "string" }
              },
              "additionalProperties": false
            },
            "codex": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "skill": { "type": "string" }
              },
              "additionalProperties": false
            },
            "opencode": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "command": { "type": "string" },
                "agent": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "whenToUse": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "toolFlow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "purpose"],
            "properties": {
              "tool": { "type": "string" },
              "purpose": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "mcp": {
          "type": "object",
          "properties": {
            "servers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "type"],
                "properties": {
                  "name": { "type": "string" },
                  "source": { "type": "string" },
                  "type": { "enum": ["local", "remote"] },
                  "enabled": { "type": "boolean" },
                  "command": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "environment": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  },
                  "url": { "type": "string" },
                  "headers": {
                    "type": "object",
                    "additionalProperties": { "type": "string" }
                  },
                  "oauth": {
                    "oneOf": [
                      { "type": "object" },
                      { "const": false }
                    ]
                  },
                  "timeout": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": { "type": { "const": "local" } },
                      "required": ["type"]
                    },
                    "then": { "required": ["command"] }
                  },
                  {
                    "if": {
                      "properties": { "type": { "const": "remote" } },
                      "required": ["type"]
                    },
                    "then": { "required": ["url"] }
                  }
                ]
              }
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "server"],
                "properties": {
                  "name": { "type": "string" },
                  "server": { "type": "string" },
                  "toolset": { "type": "string" },
                  "description": { "type": "string" },
                  "requiredScopes": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                },
                "additionalProperties": false
              }
            },
            "prompts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["config", "files"],
            "properties": {
              "config": {
                "type": "object"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "source": { "type": "string", "minLength": 1 },
                    "skillContract": { "type": "string", "minLength": 1 },
                    "commandContract": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false,
                  "oneOf": [
                    { "required": ["source"] },
                    { "required": ["skillContract"] },
                    { "required": ["commandContract"] }
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "opencode": {
          "type": "object",
          "deprecated": true,
          "properties": {
            "profile": {
              "type": "object",
              "required": ["config", "files"],
              "properties": {
                "config": {
                  "type": "object"
                },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["path", "content"],
                    "properties": {
                      "path": { "type": "string", "minLength": 1 },
                      "content": { "type": "string" }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "reporting": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "array", "object"]
        },
        "required": { "type": "boolean" },
        "items": { "$ref": "#/$defs/field" }
      },
      "additionalProperties": false
    }
    ,
    "localRef": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
