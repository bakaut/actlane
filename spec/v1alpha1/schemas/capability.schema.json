{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/capability.schema.json",
  "title": "Actlane Capability",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "Capability" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string" },
        "description": { "type": "string" }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["whenToUse", "targets", "inputs", "outputs", "policies"],
      "properties": {
        "whenToUse": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "const": "opencode" }
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "outputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/field" }
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "toolFlow": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "purpose"],
            "properties": {
              "tool": { "type": "string" },
              "purpose": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "reporting": {
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      },
      "patternProperties": {
        "^x-": true
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "array", "object"]
        },
        "required": { "type": "boolean" },
        "items": { "$ref": "#/$defs/field" }
      },
      "additionalProperties": false
    }
  }
}
