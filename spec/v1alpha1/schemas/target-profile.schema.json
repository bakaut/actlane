{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/target-profile.schema.json",
  "title": "Actlane TargetProfile",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "TargetProfile" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["target", "output"],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "output": {
          "type": "object",
          "required": ["root", "config"],
          "properties": {
            "root": { "type": "string", "minLength": 1 },
            "config": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "transforms": {
          "type": "object",
          "properties": {
            "mcp": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "configKey": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "install": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
