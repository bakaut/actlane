{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/target-profile.schema.json",
  "title": "Actlane TargetProfile",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "TargetProfile" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "const": "opencode" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["target", "output"],
      "properties": {
        "target": { "const": "opencode" },
        "output": { "type": "object" },
        "install": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
