{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/tool-call-policy.schema.json",
  "title": "Actlane ToolCallPolicy",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "ToolCallPolicy" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "allow": { "type": "array", "items": { "type": "object" } },
        "deny": { "type": "array", "items": { "type": "object" } },
        "mutate": { "type": "array", "items": { "type": "object" } },
        "requiresApproval": { "type": "array", "items": { "type": "object" } },
        "audit": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
