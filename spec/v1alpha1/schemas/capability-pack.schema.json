{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/capability-pack.schema.json",
  "title": "Actlane CapabilityPack",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "CapabilityPack" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": ["capabilities", "policies", "targets"],
      "properties": {
        "guidance": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "path"],
                "properties": {
                  "name": { "type": "string" },
                  "path": { "type": "string" },
                  "role": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "compose": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "output": { "type": "string" },
                "strategy": { "type": "string" },
                "order": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contracts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "runtimeProfiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "targetProfiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mcpBindings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "adoptionProfile": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
