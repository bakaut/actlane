{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/capability-pack.schema.json",
  "title": "Actlane CapabilityPack",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "CapabilityPack" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["capabilities", "policies", "targets"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "targetProfiles": {
          "type": "array",
          "items": { "type": "string" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "adoptionProfile": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
