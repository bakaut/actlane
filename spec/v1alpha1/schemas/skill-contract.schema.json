{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actlane.ru/schemas/v1alpha1/skill-contract.schema.json",
  "title": "Actlane SkillContract",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": "actlane.ru/v1alpha1" },
    "kind": { "const": "SkillContract" },
    "metadata": {
      "type": "object",
      "required": ["name", "description"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "properties": {
        "body": { "type": "string", "minLength": 1 },
        "bodySource": { "type": "string", "minLength": 1 },
        "scripts": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillResource" }
        },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillResource" }
        },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillResource" }
        }
      },
      "oneOf": [
        { "required": ["body"], "not": { "required": ["bodySource"] } },
        { "required": ["bodySource"], "not": { "required": ["body"] } }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "skillResource": {
      "type": "object",
      "required": ["source", "path"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
